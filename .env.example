# Server Configuration
PORT=6037

# --- Google AI Studio (default) ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Vertex AI (Google Cloud Console) ---
# Enable Vertex instead of an API key. Auth uses Application Default Credentials
# (service account JSON via GOOGLE_APPLICATION_CREDENTIALS, or gcloud ADC).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Optional AVR-prefixed aliases:
# GEMINI_USE_VERTEXAI=true
# GEMINI_VERTEX_PROJECT=your-gcp-project-id
# GEMINI_VERTEX_LOCATION=us-central1

GEMINI_MODEL=gemini-3.1-flash-live-preview

# Instruction Loading Methods (choose one):
# Method 1: Direct environment variable (highest priority)
GEMINI_INSTRUCTIONS="You are a helpful assistant that can answer questions and help with tasks."

# Method 2: Web service (medium priority) - uncomment to use
#GEMINI_URL_INSTRUCTIONS="https://your-api.com/instructions"

# Method 3: Local file (lowest priority) - uncomment to use
#GEMINI_FILE_INSTRUCTIONS="./instructions.txt"

# Optional Thinking Configuration (default: budget=0 for lowest audio latency)
# Thinking: set a budget (2.5 models; 0 disables) OR a level (3.x models), never both
# GEMINI_THINKING_LEVEL=MINIMAL
# GEMINI_THINKING_BUDGET=0

# Audio Saving Configuration
BOT_NAME=default_bot
AUDIO_SAVE_DIR=./saved_audios
AUDIO_SAVE_ENABLED=false

# Optional call tuning
# GEMINI_VAD_SILENCE_MS=1000
# GEMINI_ACTIVITY_HANDLING=NO_INTERRUPTION
# GEMINI_ENABLE_PROACTIVE_AUDIO=false
# GEMINI_INITIAL_PROMPT=Please start the conversation.
# GEMINI_SILENCE_PROMPT=Are you still there?

# Optional extension hooks (defaults to ./hooks): onConnection, getInstructions, getInitialPrompt, getSilencePrompt
# AVR_HOOKS_PATH=/usr/src/app/hooks
